# Copy this file to .env in the repo root (or packages/cli) and fill in at least one key.
# ArchadiAgent will automatically register a provider for every key it finds.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: sandbox directory the file/shell tools are confined to (default: ./workspace)
ARCHADI_WORKDIR=workspace
